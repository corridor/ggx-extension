{
  "name": "ggx-mcp",
  "displayName": "GenGuardX MCP",
  "description": "Connect your editor's AI assistant to your GenGuardX MCP server using a configurable endpoint and OAuth.",
  "version": "0.1.0",
  "publisher": "CorridorPlatforms",
  "author": "GenGuardX",
  "license": "MIT",
  "homepage": "https://genguardx.ai/",
  "repository": {
    "type": "git",
    "url": "https://github.com/corridor/ggx-extension"
  },
  "bugs": {
    "url": "https://github.com/corridor/ggx-extension/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.102.0",
    "node": ">=22.15.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ggx",
    "genguardx",
    "mcp",
    "ai",
    "governance"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Trust the workspace before exposing GenGuardX MCP tools to the editor's AI assistant."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ggxMcp.connect",
        "title": "Connect and Sign In",
        "category": "GenGuardX MCP"
      },
      {
        "command": "ggxMcp.configure",
        "title": "Configure Server",
        "category": "GenGuardX MCP"
      },
      {
        "command": "ggxMcp.openSettings",
        "title": "Open Settings",
        "category": "GenGuardX MCP"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "ggx.mcp",
        "label": "GenGuardX"
      }
    ],
    "configuration": {
      "title": "GenGuardX MCP",
      "properties": {
        "ggxMcp.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Full Streamable HTTP MCP endpoint for your GenGuardX deployment. No default server is configured. HTTPS is required, except HTTP on localhost, 127.0.0.1 or [::1] for local development. Include the full path; nothing is appended. URL credentials, query strings and fragments are not allowed. Sign in through the editor's OAuth prompt. Only user settings are read.",
          "order": 1
        },
        "ggxMcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Make the configured server available to the editor. This does not start it or bypass tool approvals. No server is available until a valid URL is configured.",
          "order": 2
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node test/integration/run.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "package:list": "vsce ls --no-dependencies",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.5"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  }
}
